# Commando Center settings (see docs/INSTALLATION.md). On Railway, set these as service variables.

# Postgres server. With COMMANDO_DB_NAME, the center uses (and creates) its own database on it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
COMMANDO_DB_NAME=commando

# Shared login password, at least 12 characters. Never commit the real one.
COMMANDO_PASSWORD=

# Optional: GitHub token (read-only, public repos) for a higher API rate limit when reading releases.
# GITHUB_TOKEN=

# Optional: the Supertext translation proxy, for the "Translation proxy" tab (its REVIEW_USAGE_TOKEN as the token).
# COMMANDO_PROXY_URL=https://review-proxy.up.railway.app
# COMMANDO_PROXY_TOKEN=

# Optional: time zone for dates in the UI (default Europe/Zurich).
# COMMANDO_TIMEZONE=Europe/Zurich
