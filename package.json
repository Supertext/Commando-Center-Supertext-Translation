{
  "name": "supertext-commando-center",
  "version": "0.1.0",
  "description": "Supertext Commando Center: which Supertext plugin and system versions each installation runs.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "docs:screenshots": "node scripts/docs-screenshots.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
