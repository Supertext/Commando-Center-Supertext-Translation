{
    "name": "supertext/plugin-health",
    "description": "Supertext Plugin Health: version reports, API key check results and the reachability ping of Supertext plugins, for the Supertext Commando Center.",
    "type": "library",
    "license": "MIT",
    "keywords": ["supertext", "plugin", "health", "version-report"],
    "homepage": "https://github.com/Supertext/Commando-Center-Supertext-Translation/tree/main/plugin-health",
    "authors": [
        { "name": "Supertext AG", "homepage": "https://www.supertext.com" }
    ],
    "support": {
        "issues": "https://github.com/Supertext/Commando-Center-Supertext-Translation/issues",
        "source": "https://github.com/Supertext/Commando-Center-Supertext-Translation"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Needed only for the built-in CurlTransport. Not needed when you pass your own HttpTransport (e.g. wrapping your CMS's HTTP client)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "Supertext\\PluginHealth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Supertext\\PluginHealth\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
